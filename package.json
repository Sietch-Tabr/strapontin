{
  "name": "concert-web",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "worker:dev": "pnpm --filter worker dev",
    "dev:all": "pnpm --parallel --filter '@strapontin/web' --filter '@strapontin/worker' dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "web-push": "^3.6.7"
  }
}
