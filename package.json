{
  "name": "concert-web",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "worker:dev": "pnpm --filter worker dev",
    "dev:all": "pnpm --parallel --filter '@strapontin/web' --filter '@strapontin/worker' dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "web-push": "^3.6.7"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0",
      "postcss": ">=8.5.10"
    }
  }
}
