<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>fr.strapontin</groupId>
    <artifactId>strapontin-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>core</module>
        <module>sources</module>
        <module>worker</module>
        <module>web</module>
    </modules>

    <properties>
        <!-- Version CI-friendly : un seul bump ici met à jour parent + 4 modules enfants -->
        <revision>3.1.0</revision>
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versions plus récentes que celles du BOM Spring Boot 4.1.1 (Flyway 12.4.0, Caffeine 3.2.4) -->
        <flyway.version>13.9.0</flyway.version>
        <caffeine.version>3.3.0</caffeine.version>
        <!-- Versions non gérées par le BOM -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <webpush.version>5.1.2</webpush.version>
        <!-- Dépendances de compilation de web-push, qui ne les tire qu'au runtime -->
        <httpclient.version>4.5.14</httpclient.version>
        <jose4j.version>0.9.7</jose4j.version>
        <okapibarcode.version>0.5.7</okapibarcode.version>
        <resend.version>4.29.0</resend.version>
        <!-- resend-java dépend directement d'okhttp-jvm (variante JVM d'okhttp 5, module Kotlin
             Multiplatform) ; version alignée ici sur la dernière publiée. -->
        <okhttp-jvm.version>5.5.1</okhttp-jvm.version>
        <springdoc.version>3.1.1</springdoc.version>
        <jsoup.version>1.23.2</jsoup.version>
        <!-- Valeur vide par défaut — JaCoCo ou autre plugin peut la surcharger -->
        <argLine></argLine>
        <!-- Propriété dédiée à l'agent JaCoCo, distincte de argLine : le module worker fixe déjà
             argLine (flag native access requis par JNA/Testcontainers) que jacoco:prepare-agent
             écraserait sinon en écrivant dans la même propriété. -->
        <jacocoArgLine></jacocoArgLine>
        <checkstyle.version>3.6.0</checkstyle.version>
        <pmd.version>3.28.0</pmd.version>
        <!-- PMD core surchargé — nécessaire pour le support Java 26, cf. commentaire sur le plugin -->
        <pmdCore.version>7.28.0</pmdCore.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotless.version>3.10.4</spotless.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito 5.x : chargement explicite en agent évite le self-attach JDK 25 -->
                        <argLine>@{argLine} @{jacocoArgLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle.version}</version>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                        <!-- config_loc : résout le SuppressionXpathFilter référencé depuis checkstyle.xml
                             (chemin relatif au fichier de configuration lui-même, non auto-résolu). -->
                        <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}</propertyExpansion>
                        <!-- Bloquant depuis v2.9.1 (existant nettoyé à 0 violation, confirmé par
                             un run réel sur les 4 modules avant bascule). -->
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd.version}</version>
                    <!-- pmd-core/pmd-java surchargés : maven-pmd-plugin 3.28.0 (dernière version,
                         cf. check-deps) embarque encore PMD 7.17.0, qui ne sait pas analyser du
                         bytecode Java 26 ("Unsupported class file major version 70") et
                         misclassifie certains types du JDK (java.util.Map) s'il tourne lui-même
                         sous un JVM hôte Java 26 — PMD ne supporte Java 26 que depuis 7.21.0. -->
                    <dependencies>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>${pmdCore.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmdCore.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <!-- Bloquant depuis v2.9.1 (existant nettoyé à 0 violation, confirmé par
                             un run réel sur les 4 modules avant bascule). -->
                        <failOnViolation>true</failOnViolation>
                        <!-- Aucun rapport HTML JXR généré : sans ce réglage, chaque module
                             avertit qu'aucune source XRef n'est disponible. -->
                        <linkXRef>false</linkXRef>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <propertyName>jacocoArgLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- Formatage Google Java Style vérifié en CI (spotless:check, step static-analysis),
                         indépendamment du hook d'écriture local. google-java-format 1.37.0 échoue
                         dans Spotless 3.10.3 (exception au chargement du formateur) : 1.36.1.
                         Les exports du compilateur requis par le formateur sont posés dans
                         .mvn/jvm.config : sans eux, Spotless les force via sun.misc.Unsafe
                         (avertissement JDK, diffplug/spotless#2808). -->
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.36.1</version>
                                <formatJavadoc>false</formatJavadoc>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Héritées automatiquement par core/sources/web/worker, sans redéclaration par module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Modules internes -->
            <dependency>
                <groupId>fr.strapontin</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.strapontin</groupId>
                <artifactId>sources</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- BouncyCastle — jdk18on uniquement (jdk15on incompatible Java 25) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Push VAPID — exclure bcprov-jdk15on tiré par webpush-java -->
            <dependency>
                <groupId>nl.martijndwars</groupId>
                <artifactId>web-push</artifactId>
                <version>${webpush.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.bouncycastle</groupId>
                        <artifactId>bcprov-jdk15on</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- jsonassert — exclure android-json (doublon org.json.JSONObject avec org.json:json) -->
            <dependency>
                <groupId>org.skyscreamer</groupId>
                <artifactId>jsonassert</artifactId>
                <version>${jsonassert.version}</version>
                <scope>test</scope>
                <exclusions>
                    <exclusion>
                        <groupId>com.vaadin.external.google</groupId>
                        <artifactId>android-json</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Email transactionnel -->
            <dependency>
                <groupId>com.resend</groupId>
                <artifactId>resend-java</artifactId>
                <version>${resend.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp-jvm.version}</version>
            </dependency>

            <!-- OpenAPI / Swagger UI (série 3.x pour Spring Boot 4.x) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Lecture des pages HTML des sites de salles (analyseur HTML seul : la vulnérabilité
                 connue de 1.23.2 vise l'analyseur XML, jamais utilisé ici) -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bitbucket.b_c</groupId>
                <artifactId>jose4j</artifactId>
                <version>${jose4j.version}</version>
            </dependency>

            <!-- QR code SVG de l'enrôlement TOTP -->
            <dependency>
                <groupId>uk.org.okapibarcode</groupId>
                <artifactId>okapibarcode</artifactId>
                <version>${okapibarcode.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.beust</groupId>
                        <artifactId>jcommander</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>
