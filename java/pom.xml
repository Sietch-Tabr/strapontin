<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>fr.strapontin</groupId>
    <artifactId>strapontin-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>core</module>
        <module>sources</module>
        <module>worker</module>
        <module>web</module>
    </modules>

    <properties>
        <!-- Version CI-friendly (#764) : un seul bump ici met à jour parent + 4 modules enfants -->
        <revision>3.0.2</revision>
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Override BOM : Spring Boot 4.1.0 tire Flyway 12.4.0 ; on requiert 12.9.0+. -->
        <flyway.version>13.8.0</flyway.version>
        <caffeine.version>3.3.0</caffeine.version>
        <postgresql.version>42.7.13</postgresql.version>
        <!-- Versions non gérées par le BOM -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <webpush.version>5.1.2</webpush.version>
        <!-- v4.15.0/v4.16.0 tirent com.squareup.okhttp3:okhttp:5.4.0, dont l'artefact Maven
             publié est volontairement vide côté JVM depuis okhttp 5.0.0 (square/okhttp#8913) :
             okhttp est désormais un module Kotlin Multiplatform, Gradle résout la bonne variante
             automatiquement mais Maven doit choisir explicitement okhttp-jvm. Exclu ci-dessous
             et remplacé par une dépendance directe sur okhttp-jvm (jar JVM complet, contient
             bien okhttp3.RequestBody). -->
        <!-- À partir de 4.19.0, publication sur Maven Central sans le préfixe "v" -->
        <resend.version>4.28.0</resend.version>
        <okhttp-jvm.version>5.5.0</okhttp-jvm.version>
        <springdoc.version>3.1.1</springdoc.version>
        <bucket4j.version>8.20.0</bucket4j.version>
        <!-- Valeur vide par défaut — JaCoCo ou autre plugin peut la surcharger -->
        <argLine></argLine>
        <!-- Propriété dédiée à l'agent JaCoCo, distincte de argLine : le module worker fixe déjà
             argLine (flag native access requis par JNA/Testcontainers) que jacoco:prepare-agent
             écraserait sinon en écrivant dans la même propriété. -->
        <jacocoArgLine></jacocoArgLine>
        <checkstyle.version>3.6.0</checkstyle.version>
        <pmd.version>3.28.0</pmd.version>
        <!-- PMD core surchargé — nécessaire pour le support Java 26, cf. commentaire sur le plugin -->
        <pmdCore.version>7.28.0</pmdCore.version>
        <jacoco.version>0.8.15</jacoco.version>
        <spotless.version>3.10.3</spotless.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito 5.x : chargement explicite en agent évite le self-attach JDK 25 -->
                        <argLine>@{argLine} @{jacocoArgLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle.version}</version>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                        <!-- config_loc : résout le SuppressionXpathFilter référencé depuis checkstyle.xml
                             (chemin relatif au fichier de configuration lui-même, non auto-résolu). -->
                        <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}</propertyExpansion>
                        <!-- Bloquant depuis v2.9.1 (existant nettoyé à 0 violation, confirmé par
                             un run réel sur les 4 modules avant bascule). -->
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd.version}</version>
                    <!-- pmd-core/pmd-java surchargés : maven-pmd-plugin 3.28.0 (dernière version,
                         cf. check-deps) embarque encore PMD 7.17.0, qui ne sait pas analyser du
                         bytecode Java 26 ("Unsupported class file major version 70") et
                         misclassifie certains types du JDK (java.util.Map) s'il tourne lui-même
                         sous un JVM hôte Java 26 — PMD ne supporte Java 26 que depuis 7.21.0. -->
                    <dependencies>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-core</artifactId>
                            <version>${pmdCore.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmdCore.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <!-- Bloquant depuis v2.9.1 (existant nettoyé à 0 violation, confirmé par
                             un run réel sur les 4 modules avant bascule). -->
                        <failOnViolation>true</failOnViolation>
                        <!-- Aucun rapport HTML JXR généré : sans ce réglage, chaque module
                             avertit qu'aucune source XRef n'est disponible. -->
                        <linkXRef>false</linkXRef>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <propertyName>jacocoArgLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- Formatage Google Java Style vérifié via Maven (télécharge google-java-format
                         depuis Maven Central), indépendant d'un binaire local installé — le hook
                         d'écriture (google-java-format en CLI) peut être absent sur une autre machine
                         ou en CI. Pas d'exécution liée pour l'instant : mesure manuelle d'abord
                         (mvn spotless:check), avant de décider du binding à verify. -->
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.36.1</version>
                                <formatJavadoc>false</formatJavadoc>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Héritées automatiquement par core/sources/web/worker, sans redéclaration par module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Modules internes -->
            <dependency>
                <groupId>fr.strapontin</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.strapontin</groupId>
                <artifactId>sources</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- BouncyCastle — jdk18on uniquement (jdk15on incompatible Java 25) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Push VAPID — exclure bcprov-jdk15on tiré par webpush-java -->
            <dependency>
                <groupId>nl.martijndwars</groupId>
                <artifactId>web-push</artifactId>
                <version>${webpush.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.bouncycastle</groupId>
                        <artifactId>bcprov-jdk15on</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- jsonassert — exclure android-json (doublon org.json.JSONObject avec org.json:json) -->
            <dependency>
                <groupId>org.skyscreamer</groupId>
                <artifactId>jsonassert</artifactId>
                <version>${jsonassert.version}</version>
                <scope>test</scope>
                <exclusions>
                    <exclusion>
                        <groupId>com.vaadin.external.google</groupId>
                        <artifactId>android-json</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- Email transactionnel -->
            <dependency>
                <groupId>com.resend</groupId>
                <artifactId>resend-java</artifactId>
                <version>${resend.version}</version>
                <exclusions>
                    <!-- Coquille vide côté JVM (square/okhttp#8913) — voir okhttp-jvm ci-dessous -->
                    <exclusion>
                        <groupId>com.squareup.okhttp3</groupId>
                        <artifactId>okhttp</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp-jvm.version}</version>
            </dependency>

            <!-- OpenAPI / Swagger UI (série 3.x pour Spring Boot 4.x) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Rate limiting login (5 tentatives / 15 min) -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>
