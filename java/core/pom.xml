<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.strapontin</groupId>
        <artifactId>strapontin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>core</artifactId>

    <dependencies>
        <!-- Dérivation de clé pour ConfigCipher -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- Envoi Web Push (chiffrement et en-têtes VAPID) -->
        <dependency>
            <groupId>com.interaso</groupId>
            <artifactId>webpush</artifactId>
        </dependency>

        <!-- PessimisticLockingFailureException pour RetrySerialisable — artefact minimal
             (hiérarchie d'exceptions génériques, pas de JDBC/web), déjà tiré transitivement par
             web et worker via spring-boot-starter-jdbc. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- CadenceurAppelsPartage (JDBC) : web et worker le fournissent déjà, `sources` reste sans
             dépendance JDBC (optionnel, non transitif). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
