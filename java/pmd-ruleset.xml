<?xml version="1.0"?>
<ruleset name="Strapontin"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Ruleset ciblant les bugs potentiels et la conception. Toutes les catégories PMD sont incluses
    (y compris codestyle/documentation) — aucune exclusion sans mesure réelle préalable.
  </description>

  <!-- GuardLogStatement exclue après mesure : 156 sites, tous des appels SLF4J paramétrés
       (méthode {}) dont l'argument est trivial à évaluer (accesseur simple, ternaire de
       littéraux, entier/UUID) — aucun n'implique de calcul réellement coûteux (stream, boucle,
       sérialisation JSON, concaténation lourde). Un garde isXxxEnabled() n'apporterait aucun gain
       de performance mesurable, seulement du bruit visuel systématique. -->
  <rule ref="category/java/bestpractices.xml">
    <exclude name="GuardLogStatement"/>
  </rule>
  <!-- UnnecessaryConstructor exclue après mesure : 23 sites — contradiction directe avec
       AtLeastOneConstructor (design.xml, non exclue) pour un constructeur vide explicite :
       AtLeastOneConstructor exige ce constructeur, UnnecessaryConstructor le rejette une fois
       qu'il est vide. Conflit structurel du ruleset, pas une dette réelle.

       OnlyOneReturn exclue après mesure : 554 sites, tout le codebase utilise systématiquement le
       style retour anticipé/garde (if (...) return ...;) — restructurer en un seul retour final
       dégraderait nettement la lisibilité et irait à l'encontre du style déjà en place partout
       ailleurs dans le projet.

       LongVariable exclue après mesure : 455 sites, tous des noms français explicites conformes à
       l'exigence de nommage du projet (ex. emailAlerteService, SEUIL_APPELS_MIN_ALERTE_DEFAUT) —
       le seuil par défaut de 17 caractères est directement contradictoire avec cette exigence. -->
  <rule ref="category/java/codestyle.xml">
    <exclude name="UnnecessaryConstructor"/>
    <exclude name="OnlyOneReturn"/>
    <exclude name="LongVariable"/>
    <exclude name="CommentDefaultAccessModifier"/>
    <exclude name="ShortVariable"/>
  </rule>
  <!-- ShortVariable reconfigurée plutôt qu'exclue : seuil relevé à 2 (au lieu du minimum
       PMD par défaut de 3) pour accepter les abréviations à 2 caractères déjà établies dans le
       projet (id, tm, db, ip, ms, ok...) tout en continuant de flaguer les noms à 1 seul
       caractère (a, b, c, n, s, v...). -->
  <rule ref="category/java/codestyle.xml/ShortVariable">
    <properties>
      <property name="minimum" value="2"/>
    </properties>
  </rule>
  <!-- CommentDefaultAccessModifier reconfigurée plutôt qu'exclue : le motif par défaut
       (/\*\s*(default|package)\s*\*\/) n'accepte que le marqueur nu, sans justification — à
       l'inverse de la convention "commenter le pourquoi" du projet. Motif étendu pour accepter un
       marqueur suivi d'une explication réelle (ex. "/* package-private : Bean Spring, jamais
       appelé directement hors du conteneur. */"), jamais le marqueur seul. -->
  <rule ref="category/java/codestyle.xml/CommentDefaultAccessModifier">
    <properties>
      <property name="regex" value="/\*\s*(default|package)\b[\s\S]*\*/"/>
    </properties>
  </rule>
  <!-- UncommentedEmptyConstructor (Documentation, pas codestyle) exclue pour la même raison que
       UnnecessaryConstructor ci-dessus — même conflit avec AtLeastOneConstructor. -->
  <rule ref="category/java/documentation.xml">
    <exclude name="UncommentedEmptyConstructor"/>
    <exclude name="CommentRequired"/>
  </rule>
  <!-- CommentRequired reconfigurée plutôt qu'exclue : fieldCommentRequirement=Ignored (935 sites
       mesurés, PMD exige par défaut un Javadoc sur CHAQUE champ y compris privé — contradictoire
       avec la convention du projet, Javadoc obligatoire uniquement sur classes/méthodes
       publiques/protégées) ; publicMethodCommentRequirement reste Required (26 vraies lacunes de
       Javadoc public, corrigées séparément). -->
  <rule ref="category/java/documentation.xml/CommentRequired">
    <properties>
      <property name="fieldCommentRequirement" value="ignored"/>
    </properties>
  </rule>
  <!-- AvoidCatchingGenericException (déplacée de design.xml vers errorprone.xml depuis PMD 7.2x,
       exclusion migrée à l'identique) exclue après mesure : 112 sites sur 58 fichiers, tous en
       frontière d'appel externe (HTTP, parsing JSON/XML de réponse externe, envoi email) —
       schéma de résilience délibéré et déjà documenté (BilanFetch/SourceAvecBilanFetch) : capter
       large pour journaliser et retomber sur une valeur de repli plutôt que de laisser une
       exception imprévue interrompre tout un cycle de fetch/job. Un typage précis introduirait un
       risque réel (un type d'exception non anticipé romprait la résilience que ce pattern garantit
       justement). -->
  <rule ref="category/java/errorprone.xml">
    <exclude name="AvoidCatchingGenericException"/>
  </rule>
  <!-- AvoidInstantiatingObjectsInLoops exclue après mesure : 21 sites, très majoritairement
       l'idiome computeIfAbsent(cle, _ -> new ArrayList<>()) — PMD ne peut pas voir statiquement
       que le lambda ne s'exécute qu'au cache-miss, faux positif systématique sur cet idiome. Le
       reste correspond à des records/clés intrinsèquement dépendants de la donnée de l'itération
       (pas hissables hors boucle). Aucune occurrence où la règle signale un vrai problème. -->
  <rule ref="category/java/performance.xml">
    <exclude name="AvoidInstantiatingObjectsInLoops"/>
  </rule>

  <!-- UseConcurrentHashMap exclue après mesure : 87 sites, tous des variables locales scopées à
       une méthode (une nouvelle Map par appel, jamais un champ partagé) — aucun accès concurrent
       réel possible. Au moins une dizaine insèrent une valeur potentiellement null (colonnes SQL
       nullable, champs de record nullables comme dept/wikidataId/salle_parent_id) —
       ConcurrentHashMap lève une NullPointerException immédiate sur put(clé, null), contrairement
       à HashMap : la conversion introduirait une régression réelle sans aucun bénéfice.
       DoNotUseThreads exclue après mesure : 10 sites, systématiquement
       Thread.startVirtualThread/newVirtualThreadPerTaskExecutor pour du fire-and-forget hors
       contexte J2EE (jobs Quartz, appels HTTP sortants) — la primitive Java 21+ recommandée par
       les règles du projet lui-même, jamais le cas (pool de threads non borné en environnement
       serveur) que la règle vise réellement. -->
  <rule ref="category/java/multithreading.xml">
    <exclude name="UseConcurrentHashMap"/>
    <exclude name="DoNotUseThreads"/>
  </rule>
  <rule ref="category/java/security.xml"/>

  <!-- LawOfDemeter exclue après mesure : 33 sites, tous un appel d'accesseur unique sur un
       paramètre d'API framework (auth.getPrincipal() Spring Security, response.getWriter()
       Servlet, context.getMergedJobDataMap()/getJobDetail().getKey() Quartz,
       response.getStatusLine() client HTTP, pubKey.getW() API clé EC Java) — aucun n'est un
       chaînage à travers les objets métier du projet, le cas que la règle vise réellement. Ces
       API ne peuvent pas être appelées autrement. -->
  <rule ref="category/java/design.xml">
    <exclude name="LawOfDemeter"/>
    <exclude name="LoosePackageCoupling"/>
  </rule>
  <!-- LoosePackageCoupling : sans packages/classes configurés, la règle ne vérifie rien
       (configerror "No packages or classes specified") — les 13 jobs Quartz ne doivent être
       instanciés que par le scheduler (Planificateur, enregistrement des JobDetail) ou déclenchés
       explicitement (TriggerController, déclenchement manuel via API) ; classes liste ces deux
       points d'entrée documentés (table "Jobs background", CLAUDE.md) comme seuls autorisés à
       importer directement les classes du package jobs. -->
  <rule ref="category/java/design.xml/LoosePackageCoupling">
    <properties>
      <property name="packages" value="fr.strapontin.worker.jobs"/>
      <property
          name="classes"
          value="fr.strapontin.worker.jobs.FetchArtistesBatchJob,fr.strapontin.worker.jobs.FetchRegionJob,fr.strapontin.worker.jobs.FetchSalleJob,fr.strapontin.worker.jobs.FetchSallesAllJob,fr.strapontin.worker.jobs.GererComptesInactifsJob,fr.strapontin.worker.jobs.GererInvitesExpiresJob,fr.strapontin.worker.jobs.NotifierDigestJob,fr.strapontin.worker.jobs.NotifierVersionJob,fr.strapontin.worker.jobs.PurgerArtistesJob,fr.strapontin.worker.jobs.PurgerConcertsJob,fr.strapontin.worker.jobs.PurgerLogsAdminJob,fr.strapontin.worker.jobs.PurgerSallesJob,fr.strapontin.worker.jobs.RecalculerMatchesJob,fr.strapontin.worker.jobs.ReconciliationNocturneJob,fr.strapontin.worker.jobs.RevoquerAdminsJob,fr.strapontin.worker.jobs.SuiviCyclesJobsJob"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="10"/>
      <property name="classReportLevel" value="50"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/NcssCount">
    <properties>
      <property name="methodReportLevel" value="50"/>
      <property name="classReportLevel" value="500"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/ExcessiveParameterList">
    <properties>
      <property name="minimum" value="8"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/TooManyMethods">
    <properties>
      <property name="maxmethods" value="30"/>
    </properties>
  </rule>
</ruleset>
