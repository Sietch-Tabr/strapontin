<?xml version="1.0"?>
<ruleset name="Strapontin"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Ruleset ciblant les bugs potentiels et la conception. Toutes les catégories PMD sont incluses
    (y compris codestyle/documentation) — aucune exclusion sans mesure réelle préalable.
  </description>

  <!-- GuardLogStatement exclue après mesure : 156 sites, tous des appels SLF4J paramétrés
       (méthode {}) dont l'argument est trivial à évaluer (accesseur simple, ternaire de
       littéraux, entier/UUID) — aucun n'implique de calcul réellement coûteux (stream, boucle,
       sérialisation JSON, concaténation lourde). Un garde isXxxEnabled() n'apporterait aucun gain
       de performance mesurable, seulement du bruit visuel systématique. -->
  <rule ref="category/java/bestpractices.xml">
    <exclude name="GuardLogStatement"/>
  </rule>
  <rule ref="category/java/codestyle.xml"/>
  <rule ref="category/java/documentation.xml"/>
  <rule ref="category/java/errorprone.xml"/>
  <rule ref="category/java/performance.xml"/>

  <!-- UseConcurrentHashMap exclue après mesure : 87 sites, tous des variables locales scopées à
       une méthode (une nouvelle Map par appel, jamais un champ partagé) — aucun accès concurrent
       réel possible. Au moins une dizaine insèrent une valeur potentiellement null (colonnes SQL
       nullable, champs de record nullables comme dept/wikidataId/salle_parent_id) —
       ConcurrentHashMap lève une NullPointerException immédiate sur put(clé, null), contrairement
       à HashMap : la conversion introduirait une régression réelle sans aucun bénéfice. -->
  <rule ref="category/java/multithreading.xml">
    <exclude name="UseConcurrentHashMap"/>
  </rule>
  <rule ref="category/java/security.xml"/>

  <rule ref="category/java/design.xml"/>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="10"/>
      <property name="classReportLevel" value="50"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/NcssCount">
    <properties>
      <property name="methodReportLevel" value="50"/>
      <property name="classReportLevel" value="500"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/ExcessiveParameterList">
    <properties>
      <property name="minimum" value="8"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/TooManyMethods">
    <properties>
      <property name="maxmethods" value="30"/>
    </properties>
  </rule>
</ruleset>
