{
  "name": "@strapontin/worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import=tsx/esm --watch src/index.ts",
    "build": "tsc --outDir dist --declaration false",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@strapontin/core": "workspace:*",
    "@strapontin/sources": "workspace:*",
    "bullmq": "^5.76.8",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "pino": "^10.0.0",
    "resend": "^6.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
